# Dynamic dashboard → Developer Settings → SDK & API Keys
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# The same environment ID is used by the server to verify Dynamic JWTs.
DYNAMIC_ENVIRONMENT_ID=

# Local-only fallback. Leave false when using Dynamic or deploying Pact.
NEXT_PUBLIC_ENABLE_AUTH_PREVIEW=false

# Used for canonical metadata URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by the server-side agreement repositories.
DATABASE_URL=
# Use false for local/non-TLS PostgreSQL; use true when your provider requires TLS.
DATABASE_SSL=false

# Monad registry and relayer. Never expose the relayer key as NEXT_PUBLIC_*.
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MONAD_CONFIRMATIONS=1
PACT_AGREEMENT_REGISTRY_ADDRESS=
PACT_RELAYER_PRIVATE_KEY=

# Public copies are required to construct the exact EIP-712 payload in Mera.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_PACT_AGREEMENT_REGISTRY_ADDRESS=
