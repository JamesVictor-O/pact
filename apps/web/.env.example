# Dynamic dashboard → Developer Settings → SDK & API Keys
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# The same environment ID is used by the server to verify Dynamic JWTs.
DYNAMIC_ENVIRONMENT_ID=

# Local-only fallback. Leave false when using Dynamic or deploying Pact.
NEXT_PUBLIC_ENABLE_AUTH_PREVIEW=false

# Used for canonical metadata URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep this stable in production. Passkeys cannot be recovered under a different
# relying-party domain. Leave empty locally to use the current hostname.
NEXT_PUBLIC_PACT_PASSKEY_RP_ID=

# PostgreSQL connection used by the server-side agreement repositories.
DATABASE_URL=
# Use false for local/non-TLS PostgreSQL; use true when your provider requires TLS.
DATABASE_SSL=false

# Monad registry and relayer. Never expose the relayer key as NEXT_PUBLIC_*.
MONAD_RPC_URL=
MONAD_CHAIN_ID=143
MONAD_CONFIRMATIONS=1
PACT_AGREEMENT_REGISTRY_ADDRESS=
PACT_RELAYER_PRIVATE_KEY=

# Event escrow. New events receive a dedicated vault from the deployed factory.
PACT_TREASURY_ADDRESS=
PACT_EVENT_VAULT_FACTORY_ADDRESS=
PACT_ROUTE_RESOLVER_ADDRESS=
PACT_SETTLEMENT_TOKEN_ADDRESS=
PACT_SETTLEMENT_TOKEN_DECIMALS=6

# Public copies are required to construct the exact EIP-712 payload in Mera.
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_PACT_AGREEMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PACT_TREASURY_ADDRESS=
NEXT_PUBLIC_PACT_EVENT_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_PACT_SETTLEMENT_TOKEN_ADDRESS=

# Aurora Intents persistent deposits. Keep disabled until the Aurora destination
# matches the chain where PactEventVaultFactory and USDC are deployed.
AURORA_INTENTS_ENABLED=false
AURORA_INTENTS_API_KEY=
AURORA_INTENTS_BASE_URL=https://intents-api.aurora.dev
AURORA_DESTINATION_CHAIN=monad
# Prefer the exact Monad USDC asset ID if Aurora reports an ambiguous USDC symbol.
AURORA_DESTINATION_ASSET=nep245:v2_1.omni.hot.tg:143_2dmLwYWkCQKyTjeUPAsGJuiVLbFx
AURORA_DESTINATION_CHAIN_ID=143
AURORA_DESTINATION_RPC_URL=
AURORA_DESTINATION_TOKEN_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603

# Outbound payee settlement. Enable only when Pact is deployed on the Monad
# network represented by AURORA_PAYOUT_ORIGIN_ASSET_ID.
AURORA_PAYOUTS_ENABLED=false
# Obtain this exact Monad USDC assetId from GET /api/tokens/{apiKey}.
AURORA_PAYOUT_ORIGIN_ASSET_ID=nep245:v2_1.omni.hot.tg:143_2dmLwYWkCQKyTjeUPAsGJuiVLbFx
AURORA_PAYOUT_SLIPPAGE_BPS=100

# NEAR HACKATHON additions
# Private (confidential) routing mode for NEAR Intents: basic | advanced. Dry-run quotes accept both.
AURORA_PRIVATE_CONFIDENTIALITY=basic
# Public NEAR RPCs used to re-verify NEAR payout deliveries (comma separated, tried in order).
# An archival endpoint first lets Pact re-check older deliveries.
NEAR_RPC_URLS=https://archival-rpc.mainnet.fastnear.com,https://free.rpc.fastnear.com,https://rpc.mainnet.near.org
# Optional: NearBlocks key. Used only to discover candidate deliveries for Private payouts;
# every candidate is still verified on NEAR RPC.
NEARBLOCKS_API_KEY=
# Optional: NEAR Intents explorer JWT (partners.near-intents.org) for scripts/near/observer.ts.
NEAR_INTENTS_EXPLORER_JWT=
